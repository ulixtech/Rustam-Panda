{
  "manifest_version": 3,
  "name": "Rustam Panda",
  "version": "1.1.0",
  "description": "Meta Ads Library intelligence & campaign hierarchy extractor. Developed by @abbyisonline.",
  "author": "@abbyisonline",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "*://*.facebook.com/ads/library/*",
    "https://openrouter.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rustam Panda - by @abbyisonline"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/ads/library/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.facebook.com/ads/library/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "interceptor.js",
        "overlay.css",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "icons/panda.jpg",
        "report.html",
        "report.js"
      ],
      "matches": [
        "*://*.facebook.com/*"
      ]
    }
  ]
}
